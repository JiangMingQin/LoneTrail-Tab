{
  "theme": "light",
  "preferences": {
    "openInNewTab": false,
    "soundEnabled": true,
    "uiFontSize": 14,
    "clock": {
      "enabled": true,
      "showDate": true,
      "showWeek": true
    }
  },
  "keys": {
    "up": ["w", "ArrowUp"],
    "down": ["s", "ArrowDown"],
    "enter": ["d", "ArrowRight"],
    "back": ["a", "ArrowLeft"]
  }
}