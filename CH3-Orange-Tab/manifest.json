{
  "manifest_version": 3,
  "name": "CH3-Orange Tab",
  "version": "1.2.0",
  "description": "Brutalist sci-fi terminal new tab page, with keyboard-driven bookmark navigation.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "bookmarks",
    "favicon"
  ]

}
